{
  "name": "literature-listening-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/init-db.ts && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:import": "tsx scripts/import-content.ts",
    "translation:audit": "node scripts/audit-foreign-translations.mjs",
    "translation:refine": "node scripts/refine-foreign-translations.mjs",
    "audio:generate:local": "tsx scripts/generate-local-audio.ts",
    "audio:generate:tencent": "tsx scripts/generate-tencent-audio.ts",
    "tts:generate": "tsx scripts/generate-tts.ts",
    "audio:generate:edge": "tsx scripts/generate-edge-audio.ts",
    "audio:generate:edge:all": "tsx scripts/generate-all-edge-audio.ts --all"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tencentcloud-sdk-nodejs-tts": "^4.1.85",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "27.1.0",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
